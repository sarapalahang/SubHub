@model SubHub.Web.Models.PurchaseHistoryViewModel
@{
    ViewData["Title"] = "تاریخچه خرید شما";
}

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">

                <!-- عنوان -->
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light text-primary rounded-circle mb-2" style="width: 50px; height: 50px;">
                        <span class="fs-4">📋</span>
                    </div>
                    <h4 class="fw-bold text-primary">تاریخچه خرید شما</h4>
                    <p class="text-muted small">لیست سفارش‌ها و فاکتورهای قبلی‌تان را در این بخش مشاهده کنید.</p>
                </div>

                <!-- باکس جستجو -->
                <div class="row mb-4 justify-content-center">
                    <div class="col-md-6">
                        <div class="input-group">
                            <input type="text" id="searchInput" class="form-control text-center rounded-pill" placeholder="🔍 جستجو در نام آیتم..." onkeyup="filterTable()">
                        </div>
                    </div>
                </div>

                <!-- جدول سوابق خرید -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle text-center" id="historyTable">
                        <thead class="table-light">
                            <tr>
                                <th class="text-secondary fw-semibold">تاریخ</th>
                                <th class="text-secondary fw-semibold">شماره فاکتور</th>
                                <th class="text-secondary fw-semibold">آیتم</th>
                                <th class="text-secondary fw-semibold">تعداد</th>
                                <th class="text-secondary fw-semibold">مبلغ (تومان)</th>
                                <th class="text-secondary fw-semibold">وضعیت</th>
                                <th class="text-secondary fw-semibold">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items != null && Model.Items.Any())
                            {
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <!-- استفاده تمیز از TagHelper -->
                                            <display-persian-date date="@item.CreatedAtUtc"></display-persian-date>
                                        </td>
                                        <td class="text-muted small">@item.InvoiceNumber</td>
                                        <td class="fw-bold">@item.PlanName</td>
                                        <td>@item.Quantity</td>
                                        <td class="text-dark fw-bold">@item.Amount.ToString("N0")</td>
                                        <td>
                                            <span class="badge @item.StatusBadgeClass rounded-pill px-3 py-2">
                                                @item.StatusText
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-center gap-2">
                                                <a asp-action="Details" asp-controller="Invoice" asp-route-id="@item.InvoiceId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                    مشاهده
                                                </a>

                                                <a asp-action="DownloadPdf" asp-controller="Invoice" asp-route-id="@item.InvoiceId" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="دانلود فایل PDF فاکتور">
                                                    📄 دانلود PDF
                                                </a>
                                            </div>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-muted py-4">هیچ رکوردی برای نمایش یافت نشد.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    function filterTable() {
        var input = document.getElementById("searchInput");
        var filter = input.value.toLowerCase();
        var table = document.getElementById("historyTable");
        var tr = table.getElementsByTagName("tr");

        for (var i = 1; i < tr.length; i++) {
            var td = tr[i].getElementsByTagName("td")[2]; // ستون نام آیتم
            if (td) {
                var txtValue = td.textContent || td.innerText;
                if (txtValue.toLowerCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }
</script>
