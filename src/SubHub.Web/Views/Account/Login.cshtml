@{
    ViewData["Title"] = "ورود با شماره موبایل";
    string? returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container py-5" style="direction: rtl;">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <h3 class="text-center fw-bold mb-4">ورود / ثبت‌نام</h3>

                @if (TempData["AuthError"] is string authError)
                {
                    <div class="alert alert-warning" role="alert">@authError</div>
                }

                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">شماره موبایل</label>
                        <input type="text" name="phoneNumber" class="form-control form-control-lg rounded-3" placeholder="مثال: 09123456789" required />
                    </div>

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-bold">ارسال کد تایید</button>
                </form>
            </div>
        </div>
    </div>
</div>
