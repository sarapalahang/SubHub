<!-- Views/Shared/_SubHubHeader.cshtml -->
<div class="subhub-header-wrapper">
    <header class="subhub-main-header">
        <div class="container-fluid d-flex align-items-center justify-content-between">

            <!-- بخش لوگو و برند -->
            <div class="header-right-side d-flex align-items-center">
                <div class="brand-container" onclick="window.location.href='/Home/Index'">
                    <div class="brand-logo">
                        <i class="bi bi-shield-check"></i>
                        <span>SH</span>
                    </div>
                    <div class="brand-text">
                        <h1 class="brand-title">پروژه اهن جنوب</h1>
                        <span class="brand-subtitle">مدیریت هوشمند کاربران</span>
                    </div>
                </div>

                <!-- منوی اصلی (مخصوص دسکتاپ) -->
                <nav class="header-nav d-none d-lg-flex">
                    <a asp-controller="Plan" asp-action="Index" class="nav-item-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Plan" ? "active" : "")">
                        <i class="bi bi-card-checklist"></i> مدیریت اشتراک‌ها
                    </a>
                </nav>
            </div>

            <!-- بخش ابزارها و پروفایل (هوشمند بر اساس لاگین) -->
            <div class="header-left-side d-flex align-items-center gap-3">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    var mobile = User.FindFirst(System.Security.Claims.ClaimTypes.MobilePhone)?.Value ?? "کاربر مهمان";

                    <div class="user-profile-brief d-none d-sm-flex align-items-center">
                        <div class="user-info text-start me-3">
                            <span class="user-name d-block">@mobile</span>
                            <span class="user-role d-block">مشتری فعال</span>
                        </div>
                        <div class="user-avatar">
                            <img src="https://ui-avatars.com/api/?name=@mobile&background=2563eb&color=fff" alt="User">
                        </div>
                    </div>

                    <div class="header-divider d-none d-sm-block"></div>

                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-header-logout" title="خروج از سامانه">
                            <i class="bi bi-box-arrow-right"></i>
                            <span class="d-none d-md-inline">خروج</span>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4 py-2 rounded-3 fw-bold shadow-sm">
                        <i class="bi bi-box-arrow-in-right"></i> ورود به سامانه
                    </a>
                }
            </div>

        </div>
    </header>
</div>

<!-- استایل‌های اختصاصی هدر -->
<style>
    :root {
        --header-bg: #ffffff;
        --primary-color: #2563eb;
        --text-main: #1e293b;
        --text-muted: #64748b;
        --border-color: #f1f5f9;
        --transition: all 0.3s ease;
    }

    .subhub-header-wrapper {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: var(--header-bg);
        border-bottom: 1px solid var(--border-color);
        box-shadow: 0 2px 15px rgba(0,0,0,0.03);
    }

    .subhub-main-header {
        height: 72px;
        display: flex;
        align-items: center;
        padding: 0 15px;
        direction: rtl;
    }

    /* استایل لوگو */
    .brand-container {
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        margin-left: 40px;
    }

    .brand-logo {
        background: var(--primary-color);
        color: white;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-weight: 800;
        font-size: 1.1rem;
        box-shadow: 0 4px 10px rgba(37, 99, 235, 0.2);
    }

    .brand-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--text-main);
        margin: 0;
        line-height: 1;
    }

    .brand-subtitle {
        font-size: 0.75rem;
        color: var(--text-muted);
        font-weight: 500;
    }

    /* استایل منو */
    .header-nav {
        display: flex;
        gap: 8px;
    }

    .nav-item-link {
        text-decoration: none !important;
        color: var(--text-muted);
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: var(--transition);
    }

        .nav-item-link i {
            font-size: 1.1rem;
        }

        .nav-item-link:hover {
            background: #f8fafc;
            color: var(--primary-color);
        }

        .nav-item-link.active {
            background: #eff6ff;
            color: var(--primary-color);
        }

    /* بخش کاربر و دکمه‌ها */
    .user-info {
        line-height: 1.3;
    }

    .user-name {
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--text-main);
    }

    .user-role {
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    .user-avatar img {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        border: 2px solid var(--border-color);
    }

    .header-divider {
        width: 1px;
        height: 30px;
        background: var(--border-color);
        margin: 0 10px;
    }

    .btn-header-logout {
        border: 1px solid #fee2e2;
        background: #fff5f5;
        color: #ef4444;
        padding: 8px 18px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: var(--transition);
        text-decoration: none;
    }

        .btn-header-logout:hover {
            background: #ef4444;
            color: white;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
        }
</style>
