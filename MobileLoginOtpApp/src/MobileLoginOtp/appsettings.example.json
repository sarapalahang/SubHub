{
  "ConnectionStrings": {
    "MobileLoginOtp": "Server=.;Database=MobileLoginOtpDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "SmsSettings": {
    "ApiKey": "YOUR_KAVENEGAR_API_KEY"
  },
  "ZarinPal": {
    "MerchantId": "YOUR_MERCHANT_ID",
    "CallbackUrl": "https://localhost:5001/Payment/VerifyByHttpClient"
  },
  "SmtpSettings": {
    "Host": "YOUR_SMTP_HOST",
    "Port": 587,
    "UserName": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "EnableSsl": false,
    "From": "YOUR_SENDER_EMAIL"
  },
  "GapGpt": {
    "BaseUrl": "https://api.gapgpt.app/v1",
    "ApiKey": "YOUR_GAPGPT_API_KEY",
    "Model": "gpt-4o-mini"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
