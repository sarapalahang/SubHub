@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MobileLoginOtp</title>

    <!-- لود فونت وزیرمتن برای زیبایی -->
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" />
    <link href="~/lib/persiandatepicker/persiandatepicker.css" rel="stylesheet" />
    <link href="~/lib/persiandatepicker/persiandatepicker.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
    <script src="~/lib/persiandatepicker/persiandatepicker.js"></script>
    <script src="~/lib/persiandatepicker/persiandatepicker.min.js"></script>
    <style>
        body {
            background-color: #f4f7f6;
            font-family: 'Vazirmatn', Tahoma, sans-serif; /* فونت مدرن */
        }

        .main-header {
            background: #ffffff;
            border-bottom: 1px solid #e0e0e0;
            margin-bottom: 30px;
            padding: 10px 0;
            transition: all 0.3s;
        }

        .brand {
            font-weight: 800;
            color: #0d6efd;
            font-size: 1.2rem;
        }

        .nav-link {
            color: #495057;
            font-weight: 500;
            padding: 8px 15px !important;
            border-radius: 8px;
            transition: 0.2s;
        }

            .nav-link:hover {
                background-color: #eef2f7;
                color: #0d6efd;
            }

        .btn-custom {
            padding: 8px 20px;
            border-radius: 10px;
            font-weight: 600;
        }
    </style>
</head>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/persian-date/persian-date.min.js"></script>



<body>
    
    <header class="main-header shadow-sm">
        <div class="container d-flex justify-content-between align-items-center">
            <!-- سمت راست: لوگو -->
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock-fill text-primary" style="font-size: 1.5rem;"></i>
                <span class="brand">سیستم ورود امن</span>
            </div>

            <!-- سمت چپ: منوها -->
            <nav class="d-flex align-items-center gap-2">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Hr" asp-action="Index" class="nav-link">
                            <i class="bi bi-cpu"></i>  (مدیریت)
                        </a>
                    }


                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm btn-custom">
                            <i class="bi bi-box-arrow-right"></i> خروج
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-sm btn-custom">
                        <i class="bi bi-box-arrow-in-right"></i> ورود / ثبت‌نام
                    </a>
                }
            </nav>

        </div>
    </header>

    

    <main class="main-content">
        <div class="container">
            @RenderBody()
        </div>
    </main>



    @* <link rel="stylesheet" href="/lib/jalalidatepicker/jalalidatepicker.min.css" />
    <script src="~/lib/jalalidatepicker/jalalidatepicker.min.js"></script>
    <script>
        jalaliDatepicker.startWatch();
    </script> *@
    

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script> <!-- ۱. جی‌کوئری -->
    
     <!-- ۳. پرشین‌دیت‌پیکر -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    

    <script>
        $(document).ready(function () {
            $(".persian-date").persianDatepicker({
                format: "YYYY/MM/DD",
                autoClose: true
            });
        });
    </script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>









