@model MobileLoginOtp.Domain.Entities.Role


<div class="container mt-5">
    <div class="card shadow border-0" style="border-radius: 15px;">
        <div class="card-header bg-warning text-dark py-3">
            <h5 class="mb-0"><i class="fa fa-edit me-2"></i>ویرایش نام نقش</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label class="form-label">نام جدید نقش:</label>
                    <input asp-for="Name" class="form-control form-control-lg" required />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success px-4">ذخیره تغییرات</button>
                    <a asp-action="Index" class="btn btn-secondary px-4">انصراف</a>
                </div>
            </form>
        </div>
    </div>
</div>

