@model IEnumerable<MobileLoginOtp.Application.Dtos.ViewModels.UserRoleViewModel>


<div class="container mt-5" dir="rtl">

    <h3 class="text-center mb-4">مدیریت نقش‌های کاربران</h3>

    <div class="row">

        @foreach (var user in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <partial name="_UserRowPartial"  />
            </div>
        }

    </div>

</div>

<style>

    .user-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        padding: 20px;
        border: 1px solid #eee;
        height: 100%;
    }

    .user-image {
        text-align: center;
        margin-bottom: 15px;
    }

        .user-image img {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #f1f1f1;
        }

    .user-info {
        font-size: 14px;
        margin-bottom: 8px;
    }

    .user-actions {
        border-top: 1px solid #eee;
        margin-top: 15px;
        padding-top: 12px;
    }

</style>
