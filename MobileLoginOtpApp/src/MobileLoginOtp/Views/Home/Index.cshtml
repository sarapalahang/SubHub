@{
    ViewData["Title"] = "داشبورد کاربری";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 mx-auto" style="max-width: 550px; border-radius: 20px; overflow: hidden;">
        <div class="card-header bg-primary text-white text-center py-4">
            <i class="fas fa-user-circle fa-4x mb-3"></i>
            <h3 class="fw-bold">خوش آمدید</h3>
        </div>

        <div class="card-body p-5 text-center">
            <p class="text-muted fs-5">اطلاعات حساب کاربری شما:</p>

            <div class="bg-light p-3 rounded-pill mb-4 border">
                <span class="fw-bold text-dark">
                    <i class="fas fa-id-badge me-2 text-primary"></i>
                    @(User.Identity?.Name ?? "کاربر مهمان")
                </span>
            </div>

            <div class="row g-2">

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="col-12">
                            <a asp-controller="Role"
                               asp-action="Index"
                               class="btn btn-primary btn-lg w-100 shadow-sm mb-2"
                               style="border-radius: 12px;">
                                <i class="fas fa-user-shield me-2"></i>
                                مدیریت نقش‌ها
                            </a>
                        </div>

                        <div class="col-12">
                            <a asp-controller="Role"
                               asp-action="UserManagement"
                               class="btn btn-dark btn-lg w-100 shadow-sm mb-2"
                               style="border-radius: 12px;">
                                <i class="fas fa-users-cog me-2"></i>
                                تخصیص نقش به کاربران
                            </a>
                        </div>
                    }

                    <div class="col-12">
                        <a asp-controller="Auth"
                           asp-action="Account"
                           class="btn btn-outline-primary btn-lg w-100 shadow-sm mb-2"
                           style="border-radius: 12px;">
                            <i class="fas fa-user-edit me-2"></i>
                            ویرایش پروفایل
                        </a>
                    </div>

                    <div class="col-12">
                        <a asp-controller="Auth"
                           asp-action="Logout"
                           class="btn btn-outline-danger btn-lg w-100"
                           style="border-radius: 12px;">
                            <i class="fas fa-sign-out-alt me-2"></i>
                            خروج از حساب
                        </a>
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <a asp-controller="Auth"
                           asp-action="Login"
                           class="btn btn-success btn-lg w-100 shadow-sm mb-2"
                           style="border-radius: 12px;">
                            <i class="fas fa-sign-in-alt me-2"></i>
                            ورود / عضویت
                        </a>
                    </div>
                }

            </div>
        </div>

        <div class="card-footer bg-light text-center py-3">
            <small class="text-muted">
                آخرین ورود: @DateTime.Now.ToShortDateString()
            </small>
        </div>
    </div>
</div>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />







