@model MobileLoginOtp.Domain.Entities.User


@{
    ViewData["Title"] = "تکمیل اطلاعات کاربری";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h5 class="mb-0">تکمیل مشخصات حساب کاربری</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Auth" asp-action="SaveProfile" method="post">

                        <!-- شماره موبایل فقط نمایش داده می‌شود و غیرقابل تغییر است -->
                        <div class="mb-3">
                            <label class="form-label font-weight-bold">شماره موبایل</label>
                            <input asp-for="PhoneNumber" class="form-control bg-light" readonly />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">نام</label>
                            <input asp-for="FirstName" class="form-control" placeholder="مثال: علی" required />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">نام خانوادگی</label>
                            <input asp-for="LastName" class="form-control" placeholder="مثال: محمدی" required />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">ایمیل (اختیاری)</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="info@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <hr />

                        <button type="submit" class="btn btn-success w-100 py-2">
                            ذخیره و ورود به سایت
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
