@using MobileLoginOtp.Application.Dtos.ViewModels
@model HrAssistantViewModel

@{
    ViewData["Title"] = "دستیار هوشمند منابع انسانی";
}

<div class="container mt-4" dir="rtl">
    <!-- کادر ثبت سوال -->
    <div class="card shadow-sm mb-4" style="border-radius: 12px; border: none;">
        <div class="card-header bg-primary text-white" style="border-radius: 12px 12px 0 0;">
            <h5 class="mb-0">🤖 دستیار هوشمند منابع انسانی (GapGPT)</h5>
        </div>
        <div class="card-body bg-light">
            <form asp-controller="Hr" asp-action="Index" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">سوال خود را مطرح کنید:</label>
                    <textarea asp-for="Question" class="form-control" rows="4"
                              placeholder="مثلاً: نحوه ارزیابی عملکرد کارکنان به چه صورت است؟"></textarea>
                </div>
                <button type="submit" class="btn btn-success px-4 py-2">
                    <i class="bi bi-send-fill"></i> دریافت پاسخ هوش مصنوعی
                </button>
            </form>
        </div>
    </div>

    <!-- کادر نمایش پاسخ -->
    @if (!string.IsNullOrEmpty(Model.Answer))
    {
        <div class="card shadow-sm" style="border-radius: 12px; border-right: 5px solid #0d6efd;">
            <div class="card-body" style="white-space: pre-line; line-height: 1.8; text-align: justify;">
                <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">پاسخ هوش مصنوعی:</h6>
                @Model.Answer
            </div>
        </div>
    }
</div>

